{% if proposal.isConfirmed %}
    <span class="lumen-badge lumen-badge--confirmed">✓ Confirmée</span>
{% elseif proposal.isBlocked %}
    <span class="lumen-badge lumen-badge--blocked">Indisponible</span>
{% elseif poll.hasConfirmThreshold and proposal.isThresholdReached %}
    <span class="lumen-badge lumen-badge--reached">Seuil atteint</span>
{% endif %}
